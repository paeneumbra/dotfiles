// https://yalter.github.io/niri/Configuration:-Outputs
output "eDP-1" {
    mode "2880x1800"
    scale 1.5
    transform "normal"
    position x=0 y=0
    hot-corners {
        bottom-left
    }
}
output "eDP-2" {
    mode "2880x1800"
    scale 1.5
    transform "normal"
    position x=0 y=0
    hot-corners {
        bottom-left
    }
}
output "HDMI-A-1" {
    mode "3840x2160"
    transform "normal"
    position x=1920 y=0
    hot-corners {
        bottom-right
    }
}
output "DP-1" {
    mode "3840x2160"
    transform "normal"
    position x=1920 y=0
        hot-corners {
        bottom-right
    }
}
output "DP-9" {
    mode "3840x2160"
    transform "normal"
    position x=1920 y=0
    hot-corners {
        bottom-right
    }
}
