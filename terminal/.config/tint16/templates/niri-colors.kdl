//# Tint16 generated palette
//# Theme: "{name}"
//# Author: "{author}"

layout {{
    background-color "transparent"

    focus-ring {{
        active-color   "{color4}"
        inactive-color "{color8}"
        urgent-color   "{color3}"
    }}

    border {{
        active-color   "{color4}"
        inactive-color "{color8}"
        urgent-color   "{color3}"
    }}

    shadow {{
        color "#00000070"
    }}

    tab-indicator {{
        active-color   "{color4}"
        inactive-color "{color8}"
        urgent-color   "{color3}"
    }}

    insert-hint {{
        color "#42a5f580"
    }}
}}

recent-windows {{
    highlight {{
        active-color   "{color6}"
        urgent-color   "{color3}"
    }}
}}
