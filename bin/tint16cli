#!/usr/bin/env python3
import subprocess
import sys
from pathlib import Path

# Get the project directory
project_dir = Path(__file__).resolve().parent.parent

# Run uv with the project directory
subprocess.run(
    [
        "uv", "run",
        "--project", str(project_dir),
        "python", "-c",
        "from dotfiles.tint16.cli import cli; cli()",
        *sys.argv[1:]  # Pass all arguments after the script name
    ]
)
