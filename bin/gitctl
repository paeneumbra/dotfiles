#!/usr/bin/env python3
import subprocess
import sys
from pathlib import Path

# Get the project directory
project_dir = Path(__file__).resolve().parent.parent

script_name = Path(__file__).name

# Run uv with the project directory
result = subprocess.run(
    [
        "uv",
        "run",
        "--project",
        str(project_dir),
        "python",
        "-c",
        f"from dotfiles.gitctl.cli import cli; cli(prog_name='{script_name}')",
        *sys.argv[1:],
    ],
    check=False,
)

sys.exit(result.returncode)
